# Normalize line endings: store as LF in repo
* text=auto eol=lf

# Windows scripts should use CRLF in working directory
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts stay LF
*.sh text eol=lf

# Mark binary files so Git doesn't try to diff them as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.mp4  binary
*.mov  binary
