############################
# OS / Editor junk
############################
.DS_Store
**/.DS_Store
Thumbs.db

.vscode/
.idea/
*.code-workspace

# Swap / temp files
*.swp
*.swo
*.tmp
tmp/
logs/
*.log

############################
# Python (Backend/, Admin-Dashboard/backend/, ...)
############################

# Bytecode & cache. Repo-wide: Admin-Dashboard/backend is also Python.
**/__pycache__/
**/*.py[cod]
**/*.class

# Virtualenvs (anywhere, not just Backend/ - a root .venv relies on the
# self-ignore that python -m venv writes, which older tooling omits)
.venv/
venv/
Backend/.venv/
Backend/venv/

# Test / tooling caches
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage

# Local runtime data (auto-created by main.py; Azure Blob Storage is the source of truth)
Backend/user_data/*
!Backend/user_data/.gitkeep

erase_pycache.bat
erase_pycache.py

############################
# Secrets / environment
############################
# Ignore every env file anywhere in the tree, keep only the examples.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Note: Frontend/.env.production is intentionally NOT tracked. Docker copies it
# from the working tree, so the image build does not need it in git — publishing
# it would only hardcode one deployment's hostnames for everyone who clones.
# See Frontend/.env.production.example.

# Credential material
*.pem
*.key
*.pfx
*.p12

# Internal operational notes. Holds no credential values, but names which
# secrets exist and their rotation status - not useful to publish.
Backend/SECRETS_TO_ROTATE.md

# Azure CLI / azd machine-local state. Records one developer's resource group,
# app service plan, SKU and region - deployment settings belong in env vars.
.azure/
**/.azure/

# Runtime artifacts the app regenerates. Each of these was committed-by-accident
# material before: agent setups and session docs hold per-deployment agent state,
# the Foundry cache reached 281 MB, and the token dumps captured local paths.
Backend/agent_setups/
Backend/session_docs/
**/foundry_responses_cache.json
**/token_usage_output.txt

############################
# Node / React frontend (Frontend/)
############################

# Dependencies (Frontend/, Admin-Dashboard/frontend/, ...)
**/node_modules/

# Build output
Frontend/dist/
Frontend/.build/
Frontend/.next/
Frontend/.turbo/
Frontend/.cache/
Frontend/.vite/

# Frontend logs
Frontend/npm-debug.log*
Frontend/yarn-debug.log*
Frontend/yarn-error.log*
Frontend/pnpm-debug.log*

############################
# PyInstaller build artifacts
############################
dist/
build/
*.spec

############################
# Docker / misc
############################

# Common env patterns (just in case)
# *.env.local
# *.env.development.local
# *.env.test.local
# *.env.production.local
