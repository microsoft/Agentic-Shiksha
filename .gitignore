############################
# OS / Editor junk
############################
.DS_Store
**/.DS_Store
Thumbs.db

.vscode/
.idea/
*.code-workspace

# Swap / temp files
*.swp
*.swo
*.tmp
tmp/
logs/
*.log

############################
# Python (Agentic Shiksha Platform/Backend/, Admin-Dashboard/backend/, ...)
############################

# Bytecode & cache. Repo-wide: Admin-Dashboard/backend is also Python.
**/__pycache__/
**/*.py[cod]
**/*.class

# Virtualenvs (anywhere, not just the platform backend - a root .venv relies on the
# self-ignore that python -m venv writes, which older tooling omits)
.venv/
venv/
Agentic Shiksha Platform/Backend/.venv/
Agentic Shiksha Platform/Backend/venv/

# Test / tooling caches
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage

# Local runtime data (auto-created by main.py; Azure Blob Storage is the source of truth)
Agentic Shiksha Platform/Backend/user_data/*
!Agentic Shiksha Platform/Backend/user_data/.gitkeep

erase_pycache.bat
erase_pycache.py

############################
# Secrets / environment
############################
# Ignore every env file anywhere in the tree, keep only the examples.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Credential material
*.pem
*.key
*.pfx
*.p12

# Internal operational notes. Holds no credential values, but names which
# secrets exist and their rotation status - not useful to publish.
Agentic Shiksha Platform/Backend/SECRETS_TO_ROTATE.md

# Azure CLI / azd machine-local state. Records one developer's resource group,
# app service plan, SKU and region - deployment settings belong in env vars.
.azure/
**/.azure/

# Runtime artifacts the app regenerates. Each of these was committed-by-accident
# material before: agent setups and session docs hold per-deployment agent state,
# the Foundry cache reached 281 MB, and the token dumps captured local paths.
Agentic Shiksha Platform/Backend/agent_setups/
Agentic Shiksha Platform/Backend/session_docs/
Agentic Shiksha Platform/Backend/main.ipynb
**/foundry_responses_cache.json
**/token_usage_output.txt

############################
# Node / React frontends
############################

# Dependencies (Frontend/, Admin-Dashboard/frontend/, ...)
**/node_modules/

# Compiler and lint caches
**/*.tsbuildinfo
**/.eslintcache

# Build output
Agentic Shiksha Platform/Frontend/dist/
Agentic Shiksha Platform/Frontend/.build/
Agentic Shiksha Platform/Frontend/.next/
Agentic Shiksha Platform/Frontend/.turbo/
Agentic Shiksha Platform/Frontend/.cache/
Agentic Shiksha Platform/Frontend/.vite/
Agentic Shiksha Platform/Frontend/.narration-build/
Agentic Shiksha Platform/Frontend/test-results/
Agentic Shiksha Platform/Frontend/test-results-*/
Agentic Shiksha Platform/Frontend/playwright-report/
Agentic Shiksha Platform/Frontend/coverage/
Admin-Dashboard/frontend/.cache/
Admin-Dashboard/frontend/.vite/
Admin-Dashboard/frontend/test-results/
Admin-Dashboard/frontend/test-results-*/
Admin-Dashboard/frontend/playwright-report/
Admin-Dashboard/frontend/coverage/

# Frontend logs
Agentic Shiksha Platform/Frontend/npm-debug.log*
Agentic Shiksha Platform/Frontend/yarn-debug.log*
Agentic Shiksha Platform/Frontend/yarn-error.log*
Agentic Shiksha Platform/Frontend/pnpm-debug.log*

############################
# PyInstaller build artifacts
############################
dist/
build/
*.spec

