# Independent admin API configuration contract. Deployment fields are blank.
# Populate local values only in an ignored .env, or inject them at runtime.
# Keep credentials in environment injection or an approved secret manager.
# Never copy secrets or another service's real .env into tracked files.
#
# settings.py loads only files beside itself:
# process environment > .env.<APP_ENV> > .env.
# Set APP_ENV in the process to select a profile; otherwise only .env is loaded.
# PYTHON_DOTENV_DISABLED=1 disables all dotenv reads.
APP_ENV=

# Required at service startup: explicit deployment identifiers, never defaults.
COSMOS_ENDPOINT=
COSMOS_DATABASE=
STORAGE_ACCOUNT_NAME=

# Research and chat/evaluation projects are separate settings, not aliases.
PROJECT_ENDPOINT=
INSTITUTE_RESEARCH_AGENT_NAME=
AZURE_AI_PROJECT_ENDPOINT=
LOGGING_AGENT_NAME=

# Explicit comma-separated HTTP(S) origins; no wildcard or localhost fallback.
ALLOWED_ORIGINS=

# Required only when periodic evaluation is enabled or manual evaluation is used.
AZURE_AI_SEARCH_ENDPOINT=
COMMON_INDEX_NAME=
# The deployed model identifier, not a suggested model family.
AZURE_EVAL_MODEL=

# Operational defaults do not choose a deployment.
DASHBOARD_PORT=8050
AZURE_CLI_TIMEOUT=60
EVAL_ENABLED=false
EVAL_INTERVAL_SECONDS=5
EVAL_LOOKBACK_HOURS=24
EVAL_BATCH_LIMIT=50
