# Copy to `.env` and fill in your own Azure resources:  cp .env.example .env
#
# The dashboard server reuses the Backend service's Azure resources. Copy the
# shared values (Cosmos, storage, Foundry, auth) from Backend/.env.example --
# only the variables that are specific to this service are listed below.
#
# Local development : values are read from this .env file.
# Deployed          : set them as App Service settings instead. Real environment
#                     variables take precedence, and .env is excluded from git.

# Server
DASHBOARD_PORT=8050
# Comma-separated CORS origins. Defaults to the local Vite/dev ports when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8000

# Background groundedness evaluation loop
# Off by default; the loop only runs when this is true.
EVAL_ENABLED=false
EVAL_INTERVAL_SECONDS=5
EVAL_LOOKBACK_HOURS=24
EVAL_BATCH_LIMIT=50

# Agents
INSTITUTE_RESEARCH_AGENT_NAME=institute-research-agent
