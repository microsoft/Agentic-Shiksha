# Optional local overrides. Empty values use the localhost defaults below.
# Main Backend (default http://localhost:8000); an optional /api suffix is normalized.
VITE_API_BASE_URL=
# Analytics/directory Backend (default http://localhost:8050).
VITE_DASHBOARD_API_URL=
# Opt in only when the main API permits credentialed requests from this admin UI.
# Disabled by default; no assignment permission or roster requests are made.
VITE_STUDENT_ASSIGNMENTS_ENABLED=false
