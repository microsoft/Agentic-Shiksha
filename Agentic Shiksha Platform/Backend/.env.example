# Copy to `.env` and fill in your own Azure resources:  cp .env.example .env
#
# deployment_settings.py validates required resource, database, model, URL and
# authentication settings. Missing/blank deployment values never select a default
# resource. Optional tool deployments are required when that tool is used.
# All deployment-specific fields below are deliberately value-free.
#
# Note: a variable left blank here carries its [REQUIRED] marker on the line
# above, not after the `=`. python-dotenv only strips a trailing comment when a
# value precedes it, so `KEY=  # note` would parse as the literal string `# note`.
#
# Local development : values are read from this .env file.
# Deployed          : set them as App Service settings instead. Real environment
#                     variables take precedence, and .env is excluded from the
#                     container image (see .dockerignore) so secrets never ship.
#
# Authentication
# Optional persistent Graph Memory. Leave unset/disabled for existing behavior.
# Provision the two /partitionKey Cosmos containers and private evidence storage,
# register an approved institute scope, and publish a reviewed graph before enabling.
# See learner_memory/README.md. These settings do not deploy or migrate resources.
# GRAPH_MEMORY_ENABLED=false
# GRAPH_MEMORY_WORKER_ENABLED=false
# GRAPH_MEMORY_OBSERVATION_MODEL=<existing-structured-output-deployment>
# GRAPH_MEMORY_GRAPH_CONTAINER=curriculum_graph_v1
# GRAPH_MEMORY_LEARNER_CONTAINER=learner_memory_v1
# GRAPH_MEMORY_EVIDENCE_CONTAINER=learner-evidence-v1
# GRAPH_MEMORY_MAX_QUERY_RU=100
# GRAPH_MEMORY_QUERY_TIMEOUT_SECONDS=15
#
# Generate JWT_SECRET with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# [REQUIRED] auth.py raises on import without it.
JWT_SECRET=
JWT_EXPIRY_SECONDS=604800
AZURE_AUTH_CLIENT_ID=
# [REQUIRED] explicit tenant/authority; VITE_AZURE_TENANT_ID remains an alias.
AZURE_AUTH_TENANT_ID=
AZURE_AUTH_MODE=
AZURE_CLI_TIMEOUT=
AUTH_REDIRECT_URI=
# [REQUIRED] both of the Google OAuth values below; main.py raises without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# [REQUIRED] unless AZURE_AUTH_CLIENT_ID is set - main.py falls back to this one.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Account that can never be removed and holds every privilege. [REQUIRED]
SUPER_ADMIN_EMAIL=

# Application URLs and CORS
# [REQUIRED] both public app URLs. For local runs set your explicit localhost URLs.
FRONTEND_URL=
BACKEND_URL=
# Additional allowed origins only; localhost origins are not added automatically.
CORS_ALLOWED_ORIGINS=

# Azure subscription and resource group
# [REQUIRED]
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Microsoft Foundry and agent configuration
# [REQUIRED]
AZURE_AI_PROJECT_ENDPOINT=
AZURE_FOUNDRY_ENDPOINT=
AZURE_AGENTS_CONFIG_PATH=
# [REQUIRED] both connection ids below; read by azure_services/agents/agent_creation.py.
AZURE_BING_CONNECTION_ID=
AZURE_BING_CUSTOM_SEARCH_CONNECTION_ID=
AZURE_BING_CUSTOM_SEARCH_INSTANCE=
PROJECT_ENDPOINT=
# [REQUIRED] ARM resource id used for MCP connections.
PROJECT_RESOURCE_ID=
BING_CONNECTION_ID=

# Model deployments (names must match your Foundry deployment names)
# [REQUIRED] all three; allowed deployments must include the selected default.
AZURE_AI_AGENT_MODEL_DEPLOYMENT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
AZURE_ALLOWED_DEPLOYMENTS=
# [REQUIRED] query planning / summarisation / titles and follow-ups.
AZURE_OPENAI_CHAT_MODEL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_ENDPOINT=
# [REQUIRED]
AZURE_EVAL_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
MODEL_DEPLOYMENT_NAME=

# Image generation (generate_image tool). Endpoint falls back to AZURE_FOUNDRY_ENDPOINT.
AZURE_IMAGE_ENDPOINT=
# Both are required when image generation is used.
AZURE_IMAGE_MODEL=
GENERATED_IMAGES_CONTAINER=

# Azure AI Search
# [REQUIRED]
AZURE_AI_SEARCH_SERVICE_NAME=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_VERSION=2025-11-01-preview                          # [REQUIRED]
AZURE_AI_SEARCH_CONNECTION_ID=
AZURE_AI_SEARCH_INDEX_NAME=
# [REQUIRED]
AZURE_AI_SEARCH_BLOB_CONTAINER=
AZURE_SEARCH_ENDPOINT=
# Foundry connection name for the search service, used when provisioning it.
AZURE_SEARCH_CONNECTION_NAME=
# [REQUIRED]
COMMON_DATASOURCE_NAME=
COMMON_IMAGE_CONTAINER=
COMMON_INDEX_NAME=
COMMON_INDEXER_NAME=
COMMON_SKILLSET_NAME=

# Legacy key-based access (prefer managed identity)
AZURE_STORAGE_CONNECTION_STRING=
BING_CUSTOM_SEARCH_API_KEY=
BING_CUSTOM_SEARCH_CONFIG_ID=
BLOB_STORAGE_CONNECTION_STRING=

# Azure Cosmos DB (uses Entra ID / managed identity, no keys)
# [REQUIRED] no database default; select the intended live database explicitly.
COSMOS_ENDPOINT=
COSMOS_DATABASE=
# Account short name, used by the ARM-based migration_v2 scripts.
COSMOS_ACCOUNT_NAME=
# Source and target databases for the one-off migration_v2 scripts.
COSMOS_DATABASE_V1=
COSMOS_DATABASE_V2=
# Escape hatch for read-only analysis of the frozen Phase 1 database. Leave unset:
# the client refuses to start against a frozen database unless this is true.
ALLOW_FROZEN_DATABASE=

# Runtime performance and bounded caches
EKALAIVA_MAX_SYNC_THREADS=160
COSMOS_CONNECTION_POOL_SIZE=64
CHAT_INITIAL_MESSAGE_LIMIT=200
COURSE_CURRICULUM_CACHE_MAX_ENTRIES=64
EKALAIVA_RESEARCH_MAX_PARALLEL=4
FOUNDRY_CONNECT_TIMEOUT_SECONDS=15
FOUNDRY_READ_TIMEOUT_SECONDS=180
CLARIFY_TIMEOUT_SECONDS=60

# Azure Storage
# [REQUIRED] storage account and both runtime blob container names.
STORAGE_ACCOUNT_NAME=
BLOB_CONTAINER_NAME=
AGENT_IMAGES_CONTAINER=

# Azure AI services
AI_DOCUMENT_INTELLIGENCE_ENDPOINT=
AI_SERVICES_ENDPOINT=
# [REQUIRED] resolved at import time by backend/main.py.
DOCUMENT_INTELLIGENCE_ENDPOINT=
# Content safety guardrail. Falls back to AI_SERVICES_ENDPOINT when unset;
# with neither set the guardrail is skipped.
CONTENT_SAFETY_ENDPOINT=
CONTENT_GUARDRAIL_TIMEOUT=10

# Azure Speech: optional Indian-voice presentation playback (passwordless).
# Set RESOURCE_NAME plus the explicit AZURE_SUBSCRIPTION_ID / AZURE_RESOURCE_GROUP above.
# Enable its custom domain; grant the backend identity Cognitive Services Speech User on it.
# Narration does not require REGION; voice input requires it explicitly.
# Leave RESOURCE_NAME blank to disable presentation synthesis. No key or model deployment needed.
AZURE_SPEECH_REGION=
AZURE_SPEECH_RESOURCE_NAME=

# Memory
MEMORY_CHAT_MODEL=
MEMORY_EMBEDDING_MODEL=
MEMORY_UPDATE_DELAY=

# Deep research
# [REQUIRED] DEEP_RESEARCH_AGENT_ID, DEEP_RESEARCH_BING_CONNECTION_ID and
# DEEP_RESEARCH_PROJECT_ENDPOINT are resolved at import time by backend/main.py.
DEEP_RESEARCH_AGENT_ID=
DEEP_RESEARCH_BASE_MODEL=
DEEP_RESEARCH_BING_CONNECTION_ID=
DEEP_RESEARCH_MODEL=
DEEP_RESEARCH_PROJECT_ENDPOINT=

# Research and visualization agents
TEXTBOOK_RESEARCH_AGENT_NAME=
THRESHOLD_CONCEPT_RESEARCH_AGENT_NAME=
TIKZ_GENERATOR_MODEL=
TIKZ_DISCRIMINATOR_MODEL=
TIKZ_POLISHER_MODEL=
# Set to 0/false to skip the TikZ geometry validation pass.
TIKZ_GEOMETRY_CHECK=1

# Teacher dashboard
TEACHER_ANALYTICS_AGENT_NAME=
# Local development only. Leave false: true accepts an unverified caller identity.
DASHBOARD_ALLOW_DEV_AUTH=false

# Local tooling and maintenance scripts
AGENT_ID=
AGENT_NAME=
AGENTS_CONFIG_PATH=
CHAT_MESSAGE=
POPPLER_PATH=
PDF_INPUT_DIR=
PDF_OUTPUT_DIR=
# Mirrors SUPER_ADMIN_EMAIL for the dashboard UI (cosmetic; server enforces)
VITE_SUPER_ADMIN_EMAIL=
