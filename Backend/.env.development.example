# ==========================================================================
# Development environment overrides.
#
# Selected when APP_ENV=development (the default).
# Copy this file to `.env.development` and set ONLY the keys that differ from
# the shared base `.env`. Anything left commented falls back to `.env`.
#
# Precedence (highest first):
#   1. OS / Azure App Service application settings
#   2. .env.<APP_ENV>   (this file)
#   3. .env             (shared base)
#
# NOTE: never commit real secrets. `.env.development` is gitignored;
# only this `.example` template is tracked.
# ==========================================================================
APP_ENV=development

# --- Application URLs and CORS (local / dev hosts) ---
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8000
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Azure subscription / resource group (dev) ---
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=

# --- Microsoft Foundry project (dev) ---
# AZURE_AI_PROJECT_ENDPOINT=
# PROJECT_ENDPOINT=
# PROJECT_RESOURCE_ID=

# --- Data plane resources (dev instances) ---
# COSMOS_ENDPOINT=
# COSMOS_DATABASE=
# COSMOS_CONNECTION_POOL_SIZE=64
# STORAGE_ACCOUNT_NAME=
# AZURE_AI_SEARCH_ENDPOINT=
# AZURE_AI_SEARCH_SERVICE_NAME=
# AZURE_AI_SEARCH_INDEX_NAME=

# --- Secrets (dev-only values) ---
# JWT_SECRET=
