# ==========================================================================
# Production environment overrides.
#
# Selected when APP_ENV=production.
# In Azure App Service, prefer setting these as *application settings*
# (OS environment variables) rather than shipping a file — App Service
# settings always take precedence and no secret file is deployed.
#
# This template exists so you can run against production resources locally
# (copy to `.env.production`) and to document which keys change per env.
#
# Precedence (highest first):
#   1. OS / Azure App Service application settings
#   2. .env.<APP_ENV>   (this file)
#   3. .env             (shared base)
#
# NOTE: never commit real secrets. `.env.production` is gitignored;
# only this `.example` template is tracked.
# ==========================================================================
APP_ENV=production

# --- Application URLs and CORS (production hosts) ---
# FRONTEND_URL=https://your-frontend.example.com
# BACKEND_URL=https://your-backend.example.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# AUTH_REDIRECT_URI=https://your-backend.example.com/auth/callback
# GOOGLE_REDIRECT_URI=https://your-backend.example.com/auth/google/callback

# --- Azure subscription / resource group (prod) ---
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=

# --- Microsoft Foundry project (prod) ---
# AZURE_AI_PROJECT_ENDPOINT=
# PROJECT_ENDPOINT=
# PROJECT_RESOURCE_ID=

# --- Data plane resources (prod instances) ---
# COSMOS_ENDPOINT=
# COSMOS_DATABASE=
# STORAGE_ACCOUNT_NAME=
# AZURE_AI_SEARCH_ENDPOINT=
# AZURE_AI_SEARCH_SERVICE_NAME=
# AZURE_AI_SEARCH_INDEX_NAME=

# --- Runtime performance and bounded caches ---
# EKALAIVA_MAX_SYNC_THREADS=160
# COSMOS_CONNECTION_POOL_SIZE=64
# CHAT_INITIAL_MESSAGE_LIMIT=200
# COURSE_CURRICULUM_CACHE_MAX_ENTRIES=64

# --- Secrets (managed identity preferred; set secrets via App Service) ---
# JWT_SECRET=
