# ==========================================================================
# Test environment overrides.
#
# Selected when APP_ENV=test.
# Copy this file to `.env.test` and use SAFE, non-production placeholder
# values. The test suite should never touch real dev or prod resources.
#
# Precedence (highest first):
#   1. OS / CI environment variables
#   2. .env.<APP_ENV>   (this file)
#   3. .env             (shared base)
#
# NOTE: never commit real secrets. `.env.test` is gitignored;
# only this `.example` template is tracked.
# ==========================================================================
APP_ENV=test

# --- Application URLs and CORS (loopback / fake) ---
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8000
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Fake / sandbox resource identifiers ---
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_RESOURCE_GROUP=rg-test
# AZURE_AI_PROJECT_ENDPOINT=https://test.example.com
# COSMOS_ENDPOINT=https://test.documents.azure.com:443/
# COSMOS_DATABASE=test-db
# STORAGE_ACCOUNT_NAME=teststorage
# AZURE_AI_SEARCH_ENDPOINT=https://test.search.windows.net
# AZURE_AI_SEARCH_SERVICE_NAME=test-search

# --- Secrets (dummy values only) ---
# JWT_SECRET=test-only-not-a-real-secret
