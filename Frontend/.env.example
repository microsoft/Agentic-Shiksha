# Azure AD / Microsoft Entra ID Configuration
# Get these values from Azure Portal > Azure Active Directory > App registrations

# Your Azure AD Application (client) ID
VITE_AZURE_CLIENT_ID=your-client-id-here

# Your Azure AD Tenant ID
# Use "common" for multi-tenant (work/school + personal accounts)
# Use "organizations" for work/school accounts only
# Use "consumers" for personal Microsoft accounts only
# Or use your specific tenant ID for single-tenant apps
VITE_AZURE_TENANT_ID=common

# Redirect URI (must match what's configured in Azure AD)
# For local development, this is typically http://localhost:5173 or http://localhost:5174
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Route chat through the AG-UI protocol endpoint (/chat/agui) instead of the
# legacy SSE stream. Widgets arrive as A2UI messages. Defaults to false.
VITE_USE_AGUI=false
