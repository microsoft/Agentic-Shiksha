# Production build values. Copy to `.env.production` and set your own.
#
# Everything here is PUBLIC: Vite inlines VITE_* values into the browser bundle
# at build time, so anyone who loads the site can read them. Never put a
# credential in this file.

VITE_API_BASE_URL="https://<your-backend>.azurewebsites.net"
VITE_API_URL="https://<your-backend>.azurewebsites.net"

# Microsoft Entra ID (public client identifiers, not secrets)
VITE_AZURE_CLIENT_ID=<your-app-registration-client-id>
VITE_AZURE_TENANT_ID=common
VITE_AZURE_REDIRECT_URI=https://<your-frontend>.azurewebsites.net
